'input',()=> $('room').setCustomValidity(''));
$('exit').onclick=()=>{running=false;loopGeneration++;if(ws){const old=ws;ws=null;old.close()}remotes.clear();for(const k in keys)keys[k]=false;$('game').hidden=true;$('setup').hidden=false}; $('again').onclick=()=>init();
const keyMap={ArrowLeft:'left',a:'left',A:'left',ArrowRight:'right',d:'right',D:'right',ArrowUp:'jump',w:'jump',W:'jump',' ':'jump',j:'attack',J:'attack'};
window.addEventListener('keydown',e=>{if(!running)return;const k=keyMap[e.key];if(k){keys[k]=true;e.preventDefault()}});window.addEventListener('keyup',e=>{const k=keyMap[e.key];if(k)keys[k]=false});window.addEventListener('blur',()=>{for(const k in keys)keys[k]=false});
document.querySelectorAll('[data-key]').forEach(b=>{const k=b.dataset.key;b.addEventListener('pointerdown',e=>{e.preventDefault();b.setPointerCapture(e.pointerId);keys[k]=true;b.classList.add('pressed')});['pointerup','pointercancel','lostpointercapture'].forEach(event=>b.addEventListener(event,()=>{keys[k]=false;b.classList.remove('pressed')}))});
canvas.addEventListener('pointerdown',e=>{if(e.pointerType==='mouse'){keys.attack=true}});window.addEventListener('pointerup',e=>{if(e.pointerType==='mouse')keys.attack=false});
function rect(a,b){return a.x<b.x+b.w&&a.x+a.w>b.x&&a.y<b.y+b.h&&a.y+a.h>b.y}
function burst(x,y,col,n=7){for(let i=0;i<n;i++)particles.push({x,y,vx:(Math.random()-.5)*140,vy:-Math.random()*120,life:.4+Math.random()*.4,col})}
function damageEnemy(target,amount){if(target.dead)return;target.hp-=amount;target.hit=.15;burst(target.x+target.w/2,target.y+target.h/2,'#fff0ac');if(target.hp<=0){target.dead=true;burst(target.x+target.w/2,target.y+target.h/2,'#e895ae',20);if(target===boss){won=true;$('victory').hidden=false;$('boss-ui').hidden=true;$('objective').textContent='Guardião derrotado!';say('Vitória!',2)}}}
function attack(){if(p.attack>0||won)return; const klass=config.avatar;p.attack=klass==='cavaleiro'?.36:klass==='arqueira'?.28:.55;p.anim=.18;
if(klass==='cavaleiro'){let area={x:p.dir===1?p.x+p.w:p.x-55,y:p.y-8,w:55,h:48};for(const m of [...mobs,boss])if(!m.dead&&rect(area,m))damageEnemy(m,35)}else shots.push({x:p.x+(p.dir===1?p.w:-8),y:p.y+14,w:klass==='mago'?14:16,h:klass==='mago'?14:5,vx:p.dir*(klass==='mago'?310:490),life:klass==='mago'?1.35:1.2,dmg:klass==='mago'?42:24,type:klass,enemy:false})}
function hurt(amount){if(p.inv>0||won)return;p.hp-=amount;p.inv=1.15; p.vy=-210;burst(p.x+11,p.y+15,'#ff9c96');if(p.hp<=0){p.x=checkpoint?4100:130;p.y=GROUND-34;p.vx=0;p.vy=0;p.hp=100;p.inv=2;mobs=makeMobs();boss=makeBoss();shots=[];say('Você caiu! Renascendo '+(checkpoint?'no marco.':'no início.'),4)}updateHud()}
function update(dt){if(won)return;p.attack=Math.max(0,p.attack-dt);p.anim=Math.max(0,p.anim-dt);p.inv=Math.max(0,p.inv-dt);if(keys.attack)attack();p.vx=(keys.right?1:0)*190-(keys.left?1:0)*190;if(p.vx)p.dir=Math.sign(p.vx);if(keys.jump&&!jumpLatch&&p.grounded){p.vy=-415;p.grounded=false}jumpLatch=keys.jump;p.x=Math.max(0,Math.min(WORLD-p.w,p.x+p.vx*dt));let prevBottom=p.y+p.h;p.vy=Math.min(600,p.vy+1000*dt);p.y+=p.vy*dt;p.grounded=false;if(p.vy>=0){for(const s of platforms){if(p.x+p.w>s.x&&p.x<s.x+s.w&&prevBottom<=s.y&&p.y+p.h>=s.y){p.y=s.y-p.h;p.vy=0;p.grounded=true;break}}if(p.y+p.h>=GROUND){p.y=GROUND-p.h;p.vy=0;p.grounded=true}}
if(!checkpoint&&p.x>3900){checkpoint=true;p.hp=MAXHP;updateHud();say('Marco de retorno ativado! Vida restaurada.',3)}camera+=(Math.max(0,Math.min(WORLD-W,p.x-W*.38))-camera)*Math.min(1,dt*5);
for(const m of mobs){if(m.dead)continue;m.hit=Math.max(0,m.hit-dt);m.x+=m.dir*(m.type===1?55:38)*dt;if(Math.abs(m.x-m.origin)>95)m.dir*=-1;if(rect(p,m))hurt(12)}
if(!boss.dead){boss.hit=Math.max(0,boss.hit-dt);if(Math.abs(p.x-boss.x)<700){boss.dir=p.x<boss.x?-1:1;if(Math.abs(p.x-boss.x)>100)boss.x+=boss.dir*42*dt;boss.x=Math.min(5750,Math.max(4750,boss.x));boss.shoot-=dt;if(boss.shoot<=0){boss.shoot=1.8;shots.push({x:boss.x+boss.w/2,y:boss.y+30,w:15,h:15,vx:boss.dir*220,life:3,dmg:14,enemy:true})}if(rect(p,boss)){p.x=p.x+p.w/2<boss.x+boss.w/2?boss.x-p.w:boss.x+boss.w;hurt(20)}}}
for(const s of shots){s.x+=s.vx*dt;s.life-=dt;if(s.enemy){if(rect(s,p)){hurt(s.dmg);s.life=0}}else for(const m of [...mobs,boss])if(!m.dead&&rect(s,m)){damageEnemy(m,s.dmg);s.life=0;break}}shots=shots.filter(s=>s.life>0&&s.x>-100&&s.x<WORLD+100);
for(const q of particles){q.x+=q.vx*dt;q.y+=q.vy*dt;q.vy+=220*dt;q.life-=dt}particles=particles.filter(q=>q.life>0);$('boss-ui').hidden=boss.dead||Math.abs(p.x-boss.x)>850;updateHud();if(noticeTimer>0&&(noticeTimer-=dt)<=0)$('notice').style.opacity='0';sendTimer-=dt;if(sendTimer<=0&&ws&&ws.readyState===WebSocket.OPEN){sendTimer=.1;ws.send(JSON.stringify({type:'move',x:Math.round(p.x),y:Math.r