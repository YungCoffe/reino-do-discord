ound(p.y),dir:p.dir,action:p.anim>0?'attack':!p.grounded?'jump':p.vx?'run':'idle'}))}}
function box(x,y,w,h,c){ctx.fillStyle=c;ctx.fillRect(Math.round(x),Math.round(y),w,h)}
function hillLayer(color,base,height,step,parallax){ctx.fillStyle=color;ctx.beginPath();ctx.moveTo(0,H);const off=(camera*parallax)%step;ctx.lineTo(-step,base);for(let x=-step;x<W+step;x+=step){ctx.lineTo(x+step/2-off,base-height);ctx.lineTo(x+step-off,base)}ctx.lineTo(W,H);ctx.fill()}
function drawBackground(){const pal=palette[config.theme],grad=ctx.createLinearGradient(0,0,0,GROUND);grad.addColorStop(0,pal[0]);grad.addColorStop(1,pal[1]);ctx.fillStyle=grad;ctx.fillRect(0,0,W,H);box(720-camera*.05,65,58,58,pal[3]);box(712-camera*.05,73,74,42,pal[3]);for(let i=0;i<50;i++){let x=((i*193-camera*.08)%1100+1100)%1100-60,y=20+(i*71)%220;box(x,y,i%4===0?3:2,i%4===0?3:2,'#ffffff88')}hillLayer(pal[1],385,125,260,.14);hillLayer(pal[2],430,90,190,.28);
for(let i=0;i<45;i++){let x=i*140-camera*.5; if(x< -80||x>W+80)continue;let y=380+(i*37)%30;box(x,y,9,80,'#273c49');box(x-20,y-28,48,36,'#354f5a');box(x-12,y-44,32,25,'#405d64')}
box(0,GROUND,W,H-GROUND,'#28384a');box(0,GROUND,W,7,pal[4]);for(let i=0;i<90;i++){let x=i*69-camera; if(x< -20||x>W)continue;box(x,GROUND+16+(i*23)%42,15,3,'#415068');box(x+18,GROUND+29+(i*31)%35,5,4,'#1e2c3d');box(x,GROUND-5,3,5,'#b4e6b8')}
for(const s of platforms){let x=s.x-camera;if(x+s.w<0||x>W)continue;box(x,s.y,s.w,12,'#455362');box(x,s.y,s.w,4,pal[4]);for(let i=8;i<s.w;i+=25)box(x+i,s.y+6,11,3,'#6e7773')}
for(let i=0;i<12;i++){let x=i*500+240-camera;if(x< -60||x>W+60)continue;box(x,GROUND-42,8,42,'#647080');box(x-5,GROUND-48,18,8,'#95a7a7');box(x+1,GROUND-60,6,10,pal[4]);box(x-7,GROUND-2,22,2,'#a3baa3')}
let flag=3950-camera;box(flag,GROUND-75,4,75,'#b5c7ba');box(flag+4,GROUND-73,26,16,pal[4]);box(flag+9,GROUND-69,6,6,'#fff0bf');let gate=5350-camera;box(gate,GROUND-155,22,155,'#3b405a');box(gate+130,GROUND-155,22,155,'#3b405a');box(gate,GROUND-165,152,18,'#565772');box(gate+15,GROUND-144,122,4,'#af87a4')}
function drawHero(x,y,color,dir,klass,action,banner,name,alpha=1){ctx.save();ctx.globalAlpha=alpha;x=Math.round(x);y=Math.round(y);if(dir<0){ctx.translate(x+22,0);ctx.scale(-1,1);x=0}const leg=(action==='run'&&Math.floor(performance.now()/120)%2)?3:0;box(x+3,y+25,7,9+leg,'#20243a');box(x+13,y+25,7,9-leg,'#20243a');box(x+2,y+12,19,15,color);box(x+4,y+2,15,12,'#f5c7a3');box(x+3,y,17,5,klass==='mago'?'#a89ee0':'#38425a');if(klass==='mago'){box(x+5,y-5,11,5,'#a89ee0');box(x+9,y-9,5,5,'#d3c6fb')}if(klass==='arqueira')box(x+2,y+4,4,10,'#6d4955');box(x+15,y+6,3,3,'#283142');box(x+8,y+15,5,5,'#fff1c2');box(x+20,y+14,4,10,'#f5c7a3');if(action==='attack'){box(x+21,y+11,21,4,'#fff0c6');box(x+34,y+7,5,12,'#e5faff')}ctx.restore();ctx.save();ctx.font='10px monospace';ctx.textAlign='center';ctx.fillStyle='#111a2acb';ctx.fillRect(Math.round((dir<0?0:0)+arguments[0]-25),y-20,72,13);ctx.fillStyle='#ffffff';ctx.fillText((banner==='sol'?'☀':banner==='lua'?'☾':'✦')+' '+name,arguments[0]+11,y-10,70);ctx.restore()}
function drawEnemy(m){let x=m.x-camera,y=m.y;if(x<-100||x>W+100)return;let col=m.hit>0?'#fff3c8':['#cb748e','#b08ed2','#e99e72'][m.type];box(x+3,y+7,22,18,col);box(x+7,y,14,9,col);box(x+7,y+9,4,4,'#241b31');box(x+18,y+9,4,4,'#241b31');box(x,y+20,7,5,'#693d63');box(x+22,y+20,7,5,'#693d63');if(m.hp<m.max){box(x,y-8,28,3,'#402a40');box(x,y-8,28*m.hp/m.max,3,'#ff9a9e')}}
function render(){drawBackground();for(const m of mobs)if(!m.dead)drawEnemy(m);if(!boss.dead){let x=boss.x-camera,y=boss.y;let c=boss.hit>0?'#fff2c2':'#7f5a86';box(x+8,y+19,56,57,c);box(x+14,y+4,44,28,c);box(x+4,y,12,24,'#c384a6');box(x+56,y,12,24,'#c384a6');box(x+18,y+13,10,6,'#ffe395');box(x+44,y+13,10,6,'#ffe395');box(x+30,y+35,12,20,'#e390a5');box(x,y+43,12,26,'#553f65');box(x+60,y+43,12,26,'#553f65')}
for(const s of shots)box(s.x-camera,s.y,s.w,s.h,s.enemy?'#ff7b8f':s.type==='mago'?'#b5abff':'#ffe8a5');for(const q of particles)box(q.x-camera,q.y,4,4,q.col);for(const other of remotes.values()){other.drawX+=(other.x-other.drawX)*.2;other.drawY+=(other.y-other.drawY)*.2;drawHero(other.drawX-camera,other.drawY,other.color,other.dir,other.avatar,other.action,other.banner,other.name,.8)}if(!(p.inv>0&&Math.floor(p.inv*10)%2))drawHero(p.x-camera,p.y,config.color,p.dir,config.avatar,p.anim?'attack':!p.grounded?'jump':p.vx?'run':'idle',config.banner,config.name);ctx.fillStyle='#ffffff9c';ctx.font='10px monospace';ctx.textAlign='right';ctx.fillText('MARCO '+Math.floor(p.x/100)+' / 60',W-15,H-15)}
function loop(t,generation){if(!running||generation!==loopGeneration)return;const dt=last?Math.min((t-last)/1000,.05):0;last=t;update(dt);render();requestAnimationFrame(next=>loop(next,generation))}
})();
